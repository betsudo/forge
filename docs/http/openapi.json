    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Optional only for loopback startup without --token-file. Applies to all endpoints except liveness when configured."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "schema",
          "error"
        ],
        "properties": {
          "schema": {
            "const": 1
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Artifact": {
        "type": "object",
        "required": [
          "kind",
          "sha256",
          "bytes",
          "url"
        ],
        "properties": {
          "kind": {
            "enum": [
              "source",
              "binary_ir",
              "prover",
              "verifier"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "url": {
            "type": "string",
            "description": "Origin-relative immutable HTTP URL"
          }
        }
      },
      "Bundle": {
        "type": "object",
        "required": [
          "schema",
          "bundle_id",
          "name",
          "ready",
          "source",
          "artifacts"
        ],
        "properties": {
          "schema": {
            "const": 1
          },
          "bundle_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "name": {
            "type": "string"
          },
          "ready": {
            "type": "boolean"
          },
          "format": {
            "type": "string"
          },
          "profile": {
            "type": [
              "string",
              "null"
            ]
          },
          "derivation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact_set_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "$ref": "#/components/schemas/Artifact"
          },
          "artifacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Artifact"
            }
          },
          "cache": {
            "type": "object",
            "properties": {
