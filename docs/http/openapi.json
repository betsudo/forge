    "/v1/objects/{digest}": {
      "get": {
        "summary": "Stream a verified immutable object; never generates keys",
        "parameters": [
          {
            "name": "digest",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Range",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Range",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verified exact bytes",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Strong quoted SHA-256 digest"
              },
              "Content-Length": {
                "schema": {
                  "type": "integer"
                }
              },
              "Accept-Ranges": {
                "schema": {
                  "const": "bytes"
                }
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/json": {
                "schema": {}
              }
            }
          },
          "206": {
            "description": "Single GET byte range with Content-Range"
          },
          "304": {
            "description": "Conditional hit after integrity verification"
          },
          "416": {
            "description": "Unsupported/unsatisfiable range; Content-Range bytes */size"
          },
          "400": {
            "description": "Invalid identifier, query, profile or request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
